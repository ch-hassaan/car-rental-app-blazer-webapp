<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="PDM Rentals — Premium car rental experience. Luxury sedans, SUVs, convertibles, electric vehicles and more." />
    <base href="/" />

    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />

    
    <link rel="stylesheet" href="style.css" />
    <link rel="stylesheet" href="css/chatbot.css" />
    <link rel="stylesheet" href="@Assets["RentalBlazorApp.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <CascadingAuthenticationState>
        <Routes @rendermode="InteractiveServer" />
    </CascadingAuthenticationState>

    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmxc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    
    <script src="_framework/blazor.web.js"></script>
    <script src="js/chatVoice.js"></script>

    
    <script>
        // ── SCROLL REVEAL ─────────────────────────────────────────
        // Uses IntersectionObserver to fade-in .reveal elements.
        // Kept in a WeakSet to avoid double-observing.
        const _observed = new WeakSet();
        let _revealObserver = null;

        function getRevealObserver() {
            if (_revealObserver) return _revealObserver;
            _revealObserver = new IntersectionObserver((entries) => {
                entries.forEach((entry, i) => {
                    if (entry.isIntersecting) {
                        setTimeout(() => {
                            entry.target.classList.add('visible');
                        }, i * 60);
                        _revealObserver.unobserve(entry.target);
                        _observed.delete(entry.target);
                    }
                });
            }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
            return _revealObserver;
        }

        function observeRevealElements() {
            const observer = getRevealObserver();
            document.querySelectorAll('.reveal').forEach(el => {
                if (!_observed.has(el) && !el.classList.contains('visible')) {
                    _observed.add(el);
                    observer.observe(el);
                }
            });
        }

        // ── NAVBAR SCROLL EFFECT ──────────────────────────────────
        function initNavbarScroll() {
            const navbar = document.querySelector('.pdm-navbar');
            const homeNav = document.querySelector('.home-nav');
            const target = navbar || homeNav;
            if (!target) return;
            const onScroll = () => {
                target.classList.toggle('scrolled', window.scrollY > 50);
            };
            // Re-attach to avoid duplicate listeners
            window.removeEventListener('scroll', window._pdmScrollHandler, { passive: true });
            window._pdmScrollHandler = onScroll;
            window.addEventListener('scroll', onScroll, { passive: true });
            onScroll();
        }

        // ── MOBILE MENU ───────────────────────────────────────────
        function toggleMobileMenu() {
            const menu = document.getElementById('pdm-mobile-menu');
            if (menu) menu.classList.toggle('active');
        }

        // ── MUTATION OBSERVER (core fix) ──────────────────────────
        // Watches the entire document body for any DOM changes (new elements
        // injected by Blazor) and automatically runs observeRevealElements.
        const _domObserver = new MutationObserver(() => {
            observeRevealElements();
        });

        function boot() {
            initNavbarScroll();
            observeRevealElements();
            _domObserver.observe(document.body, { childList: true, subtree: true });
        }

        // ── ENTRY POINTS ──────────────────────────────────────────
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', boot);
        } else {
            boot();
        }

        // Re-init on Blazor navigations
        document.addEventListener('blazor-enhanced-nav-completed', () => {
            initNavbarScroll();
            setTimeout(observeRevealElements, 80);
        });
        document.addEventListener('blazorNavigated', () => {
            initNavbarScroll();
            setTimeout(observeRevealElements, 80);
        });
        // Blazor server-side state updates
        document.addEventListener('blazor:afterUpdate', () => {
            observeRevealElements();
        });

        // ── PDM CHAT HELPERS ───────────────────────────────
        // Called by ChatWindow.razor via IJSRuntime.

        // Scrolls the element with the given id instantly to its bottom.
        window.pdmChatScrollToBottom = function(elementId) {
            const el = document.getElementById(elementId);
            if (el) {
                el.scrollTop = el.scrollHeight;
            }
        };

        // Focuses the element with the given id.
        // Wrapped in a rAF so the DOM is always settled before focus.
        window.pdmChatFocus = function(elementId) {
            requestAnimationFrame(() => {
                const el = document.getElementById(elementId);
                if (el) el.focus();
            });
        };

        // ── FILE DOWNLOAD HELPER ──────────────────────────────────
        window.pdmDownloadFile = function(fileName, base64String) {
            const link = document.createElement('a');
            link.download = fileName;
            link.href = 'data:application/octet-stream;base64,' + base64String;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        };
    </script>
</body>

</html>
