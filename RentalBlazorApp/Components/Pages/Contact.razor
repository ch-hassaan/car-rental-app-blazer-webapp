@page "/contact"

<PageTitle>Contact Us — PDM Rentals</PageTitle>


<div class="pdm-page-hero" style="background-image: url('https://images.unsplash.com/photo-1596524430615-b46475ddff6e?w=2400&q=80');">
    <div class="pdm-page-hero-overlay"></div>
    <div class="pdm-page-hero-content container">
        <span class="section-eyebrow" style="color:rgba(255,255,255,0.5);">Get in Touch</span>
        <h1 class="pdm-page-hero-title slide-up">Contact Us</h1>
        <p class="pdm-page-hero-sub slide-up delay-100">Stay connected and follow our journey on social media.</p>
    </div>
</div>


<section class="contact-info-strip">
    <div class="container">
        <div class="contact-info-grid">
            <div class="contact-info-item reveal">
                <div class="contact-info-icon"><i class='bx bx-phone'></i></div>
                <div class="contact-info-text">
                    <div class="contact-info-label">Phone</div>
                    <div class="contact-info-val">+92 300 1234567</div>
                </div>
            </div>
            <div class="contact-info-item reveal delay-100">
                <div class="contact-info-icon"><i class='bx bx-envelope'></i></div>
                <div class="contact-info-text">
                    <div class="contact-info-label">Email</div>
                    <div class="contact-info-val">info@pdmrentals.pk</div>
                </div>
            </div>
            <div class="contact-info-item reveal delay-200">
                <div class="contact-info-icon"><i class='bx bx-map-pin'></i></div>
                <div class="contact-info-text">
                    <div class="contact-info-label">Location</div>
                    <div class="contact-info-val">Islamabad, Pakistan</div>
                </div>
            </div>
            <div class="contact-info-item reveal delay-300">
                <div class="contact-info-icon"><i class='bx bx-time-five'></i></div>
                <div class="contact-info-text">
                    <div class="contact-info-label">Support Hours</div>
                    <div class="contact-info-val">24 / 7 Always Open</div>
                </div>
            </div>
        </div>
    </div>
</section>


<section class="contact-social-section">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <span class="section-eyebrow">Social Media</span>
            <h2 class="contact-heading">Follow Our Journey</h2>
            <p class="contact-sub">Stay updated with new fleet arrivals, exclusive offers, and behind-the-scenes content.</p>
        </div>

        <div class="row justify-content-center g-4">

            
            <div class="col-12 col-md-4 reveal">
                <div class="social-card social-insta">
                    <div class="social-icon-circle" style="background: linear-gradient(135deg, #E1306C, #FCAF45);">
                        <i class='bx bxl-instagram'></i>
                    </div>
                    <div class="social-name">Instagram</div>
                    <div class="social-handle">@@pdmrentals</div>
                    <p class="social-desc">Daily stories, new arrivals, and exclusive behind-the-scenes content.</p>
                    <a href="https://www.instagram.com" target="_blank" class="social-btn">
                        Follow Us <i class='bx bx-right-arrow-alt'></i>
                    </a>
                </div>
            </div>

            
            <div class="col-12 col-md-4 reveal delay-100">
                <div class="social-card social-fb">
                    <div class="social-icon-circle" style="background: #1877F2;">
                        <i class='bx bxl-facebook'></i>
                    </div>
                    <div class="social-name">Facebook</div>
                    <div class="social-handle">PDM Rentals</div>
                    <p class="social-desc">Like our page for the latest news, promotions, and customer stories.</p>
                    <a href="https://www.facebook.com" target="_blank" class="social-btn">
                        Like Page <i class='bx bx-right-arrow-alt'></i>
                    </a>
                </div>
            </div>

            
            <div class="col-12 col-md-4 reveal delay-200">
                <div class="social-card social-x">
                    <div class="social-icon-circle" style="background: #000;">
                        <i class='bx bxl-twitter'></i>
                    </div>
                    <div class="social-name">X (Twitter)</div>
                    <div class="social-handle">@@PDMRentals</div>
                    <p class="social-desc">Quick updates, real-time support, and industry insights on our X channel.</p>
                    <a href="https://www.twitter.com" target="_blank" class="social-btn">
                        Follow Us <i class='bx bx-right-arrow-alt'></i>
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>

<style>

.contact-info-strip {
    padding: 4rem 0;
    background: white;
    border-bottom: 1px solid rgba(5,13,45,0.06);
}
.contact-info-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
}
.contact-info-item {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1.5rem;
    border: 1px solid rgba(5,13,45,0.07);
    border-radius: 16px;
    background: #F8FAFC;
    transition: all 0.3s;
}
.contact-info-item:hover {
    border-color: rgba(37,99,235,0.2);
    box-shadow: 0 8px 28px rgba(5,13,45,0.07);
    transform: translateY(-3px);
}
.contact-info-icon {
    width: 48px; height: 48px; flex-shrink: 0;
    background: rgba(37,99,235,0.1);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; color: #2563EB;
}
.contact-info-label {
    font-size: 0.7rem; font-weight: 700;
    color: #94A3B8; text-transform: uppercase;
    letter-spacing: 0.1em; margin-bottom: 3px;
}
.contact-info-val {
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem; font-weight: 700;
    color: #050D2D;
}


.contact-social-section {
    padding: 6rem 0;
    background: #F9FAFB;
}
.contact-heading {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800; color: #050D2D;
    letter-spacing: -0.035em; margin-bottom: 0.75rem;
}
.contact-sub {
    font-size: 0.97rem; color: #64748B;
    max-width: 440px; margin: 0 auto;
    line-height: 1.8;
}


.social-card {
    background: white;
    border: 1px solid rgba(5,13,45,0.07);
    border-radius: 22px;
    box-shadow: 0 4px 20px rgba(5,13,45,0.06);
    padding: 2.75rem 2rem 2.25rem;
    text-align: center;
    transition: all 0.35s cubic-bezier(0.4,0,0.2,1);
    height: 100%;
    display: flex; flex-direction: column; align-items: center;
    position: relative; overflow: hidden;
}
.social-card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 4px;
    border-radius: 22px 22px 0 0;
}
.social-insta::before { background: linear-gradient(90deg, #E1306C, #FCAF45); }
.social-fb::before    { background: #1877F2; }
.social-x::before     { background: #000; }

.social-card:hover {
    transform: translateY(-12px);
    box-shadow: 0 28px 70px rgba(5,13,45,0.13);
    border-color: rgba(37,99,235,0.15);
}
.social-icon-circle {
    width: 72px; height: 72px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 2rem; color: white;
    margin-bottom: 1.25rem;
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
    transition: transform 0.3s;
}
.social-card:hover .social-icon-circle { transform: scale(1.08); }
.social-name {
    font-family: 'Outfit', sans-serif;
    font-size: 1.2rem; font-weight: 800; color: #050D2D;
    margin-bottom: 0.25rem;
}
.social-handle {
    font-size: 0.82rem; font-weight: 700;
    color: #2563EB; margin-bottom: 1.1rem;
    letter-spacing: 0.02em;
}
.social-desc {
    font-size: 0.87rem; color: #64748B;
    line-height: 1.75; flex-grow: 1;
    margin-bottom: 1.75rem;
}
.social-btn {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-size: 0.87rem; font-weight: 700;
    padding: 0.7rem 1.75rem;
    background: #050D2D; color: white;
    border-radius: 9px; text-decoration: none;
    transition: all 0.25s;
    margin-top: auto;
}
.social-btn:hover {
    background: #2563EB; color: white;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(37,99,235,0.35);
}

@@media (max-width: 768px) {
    .contact-info-grid { grid-template-columns: 1fr 1fr; }
}
@@media (max-width: 480px) {
    .contact-info-grid { grid-template-columns: 1fr; }
}
</style>
